# docker-compose overrides (copy to .env). All optional for local dev.
ANTHROPIC_API_KEY=            # enables /analyze, /analyze-lab, /agent-chat
LLM_PROVIDER=anthropic        # anthropic | bedrock | mock (compose default: mock)
BREVO_API_KEY=                # unset → emails are logged and skipped
BETTER_AUTH_SECRET=           # >=32 random chars; a local placeholder is used when empty
INTERNAL_API_SECRET=          # set to enable the web→api shared-secret check
NEXT_PUBLIC_VAPID_PUBLIC_KEY= # base64url P-256 public key for Web Push

# Akamai Object Storage — used by `npm run assets:upload|download -- --target akamai`
# (frontend/scripts/site-assets/sync.mjs). Not read by docker compose. Key needs read_write on the bucket.
S3_AKAMAI_ENDPOINT=https://us-ord-10.linodeobjects.com
S3_AKAMAI_REGION=us-ord
S3_AKAMAI_BUCKET=densify-vault-storage
S3_AKAMAI_ACCESS_KEY_ID=
S3_AKAMAI_SECRET_ACCESS_KEY=
S3_AKAMAI_PUBLIC_BASE_URL=https://densify-vault-storage.us-ord-10.linodeobjects.com
