# Next.js (web). Values are placeholders.
DATABASE_URL=postgresql://densify_app:CHANGE_ME@HOST:PORT/densify?sslmode=verify-full
PG_CA_CERT=                       # PEM text of the Managed PostgreSQL CA
PG_SSL=                           # "disable" for a local non-TLS Postgres
BETTER_AUTH_SECRET=               # >=32 random chars; must match across replicas and cutover
BETTER_AUTH_URL=https://app.example.com
TRUSTED_ORIGINS=https://app.example.com
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=   # base64 32 bytes; same on every replica
INTERNAL_APP_URL=http://127.0.0.1:3000  # middleware session lookup without CDN hairpin
API_INTERNAL_URL=http://densify-api:8000 # server actions → api in-cluster
INTERNAL_API_SECRET=              # optional
TZ_HEADER_NAME=x-client-timezone

S3_ENDPOINT=https://us-ord-1.linodeobjects.com
S3_PUBLIC_ENDPOINT=               # only when browsers must reach a different endpoint (local dev)
S3_REGION=us-ord-1
S3_BUCKET=densify-vault-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://densify-vault-storage.us-ord-1.linodeobjects.com
VAULT_PRESIGNED_GET=false         # default off = public-read URLs
WEBHOOK_TRUSTED_IMAGE_HOST=densify-vault-storage.us-ord-1.linodeobjects.com   # optional; defaults to the S3_PUBLIC_BASE_URL host

# Build-time (inlined into client bundles)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://densify-vault-storage.us-ord-1.linodeobjects.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_VAULT_PRESIGNED_GET=false
