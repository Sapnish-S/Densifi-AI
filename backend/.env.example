# FastAPI (api). Values are placeholders.
DATABASE_URL=postgresql://densify_app:CHANGE_ME@HOST:PORT/densify?sslmode=verify-full
PGSSLROOTCERT=/etc/densify/pg-ca.crt   # or PG_CA_CERT with PEM text
PG_CA_CERT=

S3_ENDPOINT=https://us-ord-10.linodeobjects.com
S3_REGION=us-ord
S3_BUCKET=densify-vault-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

LLM_PROVIDER=anthropic                 # anthropic | bedrock
ANTHROPIC_API_KEY=
LLM_VISION_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5
# Bedrock adapter only:
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:3000,http://127.0.0.1:3000
INTERNAL_API_SECRET=                   # optional; disabled when unset
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=densifyai@gmail.com
EMAIL_SENDER_NAME=Densify Clinical
LOG_LAB_OCR_TEXT=false                 # PHI hygiene: raw OCR text is not logged unless true
TEST_BASE_URL=http://127.0.0.1:8000
